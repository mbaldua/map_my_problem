# ─── Supabase ────────────────────────────────────────────────────────────────
# Copy your project URL and anon key from: https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://app.supabase.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key — NEVER expose this to the browser (server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── App ─────────────────────────────────────────────────────────────────────
# Public URL used for OG tags, share links, etc.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optional: Nominatim / Geocoding ─────────────────────────────────────────
# If you self-host Nominatim or use a hosted geocoder, set the base URL here.
# Default (empty) uses the public Nominatim instance (respect usage policy).
NEXT_PUBLIC_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
